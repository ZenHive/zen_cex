# ZenCex Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control - it's already in .gitignore

# ============================================================================
# EXCHANGE API CREDENTIALS (READ-ONLY ACCESS ONLY!)
# ============================================================================

# Binance API (https://www.binance.com/en/my/settings/api-management)
# - Create API key with "Enable Reading" permission ONLY
# - IP restrictions recommended for security
export BINANCE_API_KEY=your_binance_api_key_here
export BINANCE_API_SECRET=your_binance_api_secret_here
# Optional: Use testnet for development (https://testnet.binance.vision/)
export BINANCE_TESTNET=false
export BINANCE_TESTNET_API_KEY=your_testnet_key_here
export BINANCE_TESTNET_SECRET_KEY=your_testnet_secret_here

# Kraken API (https://www.kraken.com/u/settings/api)
# - Create API key with "Query Funds" and "Query Open Orders & Trades" permissions ONLY
# - Note: Kraken secret is base64 encoded
export KRAKEN_API_KEY=your_kraken_api_key_here
export KRAKEN_API_SECRET=your_kraken_api_secret_base64_here

# Deribit API (https://www.deribit.com/account/BTC-PERPETUAL/api)
# - Create API key with "account:read" and "trade:read" scopes ONLY
# - Testnet: https://test.deribit.com/account/BTC-PERPETUAL/api
export DERIBIT_CLIENT_ID=your_deribit_client_id_here
export DERIBIT_CLIENT_SECRET=your_deribit_client_secret_here
# Use test.deribit.com for testnet, www.deribit.com for mainnet
export DERIBIT_HOST=test.deribit.com

# ============================================================================
# RATE LIMITING & PERFORMANCE
# ============================================================================

# API rate limits (requests per time period)
export BINANCE_RATE_LIMIT=1200  # per minute
export BINANCE_WEIGHT_LIMIT=6000  # per minute (weight-based)
export KRAKEN_RATE_LIMIT=15  # per second (for private endpoints)
export DERIBIT_RATE_LIMIT=20  # per second
export BINANCE_FUTURES_RATE_LIMIT=2400  # per minute

# Cache TTL (seconds)
export CACHE_TTL_PRICES=5
export CACHE_TTL_POSITIONS=30
export CACHE_TTL_CEX=10

# Health check thresholds (milliseconds)
export HEALTH_WARNING_THRESHOLD=300
export HEALTH_CRITICAL_THRESHOLD=500

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable real API tests (set to false to skip integration tests)
export ENABLE_REAL_API_TESTS=true
export USE_TESTNET=false

# ============================================================================
# NOTES FOR SETUP
# ============================================================================
# 
# 1. Check ~/.zprofile or ~/.bashrc for existing API keys that might already be exported
# 2. For production, use read-only API keys with IP restrictions
# 3. Never enable trading permissions for monitoring dashboard
# 4. Test with testnet/sandbox first before using mainnet credentials
# 5. Keep this file updated as you add new integrations
# 6. Source this file in your shell: source .env
# 7. For Kraken, the secret key must be base64 encoded as provided by Kraken