{<<"name">>,<<"zen_cex">>}.
{<<"version">>,<<"0.2.0">>}.
{<<"description">>,
 <<"A comprehensive Elixir library for cryptocurrency exchange integrations with REST and WebSocket support.\nProvides unified API access to Binance and Bybit exchanges with built-in rate limiting, clock sync, and safety features.">>}.
{<<"elixir">>,<<"~> 1.18">>}.
{<<"app">>,<<"zen_cex">>}.
{<<"licenses">>,[<<"MIT">>]}.
